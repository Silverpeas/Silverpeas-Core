<!--
  Silverpeas relies on the metadata properties normalized by the Tika built-in parsers (tiff:*,
  xmpDM:*, dcterms:*, ...). The external parsers, delegating to command line tools such as ffmpeg or
  exiftool when they are available on the host, emit their own non-normalized properties and thus
  make the metadata extraction both non-deterministic (depending on the tools installed on the host)
  and unusable by Silverpeas. They are therefore excluded so that only the built-in parsers are used.
  -->
<properties>
  <parsers>
    <parser class="org.apache.tika.parser.DefaultParser">
      <parser-exclude class="org.apache.tika.parser.external.CompositeExternalParser"/>
      <parser-exclude class="org.apache.tika.parser.external.ExternalParser"/>
    </parser>
  </parsers>
</properties>
