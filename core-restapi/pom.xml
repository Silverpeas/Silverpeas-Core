<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.silverpeas</groupId>
    <artifactId>core</artifactId>
    <version>6.5-SNAPSHOT</version>
  </parent>

  <groupId>org.silverpeas.core</groupId>
  <artifactId>silverpeas-core-restapi</artifactId>
  <packaging>jar</packaging>
  <name>Silverpeas Core REST API Documentation ${project.version}</name>
  <description>
    The documentation of the REST API of Silverpeas Core. This module produces nothing but the
    documentation of the web resources exposed by the JAR modules of Silverpeas Core, which
    Smart-Doc gathers by itself from the whole project; it is built only with the restapi profile.
  </description>

  <properties>
    <!-- nothing is compiled, tested, nor published here: the sources of the other modules are
         only parsed by Smart-Doc to document the web resources they declare. -->
    <maven.main.skip>true</maven.main.skip>
    <maven.test.skip>true</maven.test.skip>
    <maven.install.skip>true</maven.install.skip>
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <!-- the whole REST API documentation is published on its own, aside from the Maven site of
       each module of Silverpeas Core. Being explicit, this URL is used as such (the artifact
       identifier isn't appended to it as it is for an inherited one). -->
  <distributionManagement>
    <site>
      <id>silverpeas_repository</id>
      <url>scp://www.silverpeas.org/var/www/docs/restapi/core</url>
    </site>
  </distributionManagement>

  <!-- the very dependencies of the modules whose sources are parsed: Smart-Doc requires them to
       resolve the types that are referred by the web resources but that are declared outside of
       those sources; without them it fails to generate anything at all. They have to be listed
       here because core-web declares them as provided, hence non-transitive. -->
  <dependencies>
    <dependency>
      <groupId>jakarta.platform</groupId>
      <artifactId>jakarta.jakartaee-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.silverpeas.core</groupId>
      <artifactId>silverpeas-core-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.silverpeas.core</groupId>
      <artifactId>silverpeas-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.silverpeas.core</groupId>
      <artifactId>silverpeas-core-rs</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.silverpeas.core</groupId>
      <artifactId>silverpeas-core-web</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.silverpeas.core</groupId>
      <artifactId>silverpeas-core-jcr</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.silverpeas.core.services</groupId>
