<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.silverpeas</groupId>
    <artifactId>core</artifactId>
    <version>6.5-SNAPSHOT</version>
  </parent>

  <groupId>org.silverpeas.core</groupId>
  <artifactId>silverpeas-core-restapi</artifactId>
  <packaging>jar</packaging>
  <name>Silverpeas Core REST API Documentation ${project.version}</name>

  <properties>
    <maven.test.skip>true</maven.test.skip>
    <maven.install.skip>true</maven.install.skip>
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <!-- the documentation of the REST API is published on its own, aside from the Maven site of
       the modules. Being explicit, this URL is used as such (the artifact identifier isn't
       appended to it as it would be for an inherited one). -->
  <distributionManagement>
    <site>
      <id>silverpeas_repository</id>
      <url>scp://www.silverpeas.org/var/www/docs/restapi/core</url>
    </site>
  </distributionManagement>

  <!-- the dependencies declared provided by core-web and core-war aren't transitive, whereas
       the scan by reflection requires their classes -->
  <dependencies>
    <!-- required to compile the filter completing the generated documentation -->
    <dependency>
      <groupId>io.swagger.core.v3</groupId>
      <artifactId>swagger-core-jakarta</artifactId>
      <version>2.2.54</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.module</groupId>
      <artifactId>jackson-module-jakarta-xmlbind-annotations</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.silverpeas.core</groupId>
      <artifactId>silverpeas-core-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.silverpeas.core</groupId>
      <artifactId>silverpeas-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.silverpeas.core</groupId>
      <artifactId>silverpeas-core-rs</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.silverpeas.core</groupId>
      <artifactId>silverpeas-core-jcr</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.silverpeas.core.services</groupId>
      <artifactId>silverpeas-core-comment</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.silverpeas.core.services</groupId>
      <artifactId>silverpeas-core-silverstatistics</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.silverpeas.core.services</groupId>
      <artifactId>silverpeas-core-pdc</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.silverpeas.core.services</groupId>
      <artifactId>silverpeas-core-search</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.silverpeas.core.services</groupId>
      <artifactId>silverpeas-core-personalorganizer</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.silverpeas.core.services</groupId>
      <artifactId>silverpeas-core-contact</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.silverpeas.core.services</groupId>
      <artifactId>silverpeas-core-mylinks</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.silverpeas.core.services</groupId>
      <artifactId>silverpeas-core-importexport</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.silverpeas.core.services</groupId>
      <artifactId>silverpeas-core-tagcloud</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.silverpeas.core.services</groupId>
      <artifactId>silverpeas-core-questioncontainer</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.silverpeas.core.services</groupId>
      <artifactId>silverpeas-core-viewer</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.silverpeas.core.services</groupId>
      <artifactId>silverpeas-core-document-template</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.silverpeas.core.services</groupId>
      <artifactId>silverpeas-core-workflow</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.silverpeas.core.services</groupId>
      <artifactId>silverpeas-core-sharing</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.silverpeas.core.services</groupId>
      <artifactId>silverpeas-core-chat</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>jakarta.platform</groupId>
      <artifactId>jakarta.jakartaee-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.silverpeas.jakarta</groupId>
      <artifactId>portlet</artifactId>
      <classifier>jakarta</classifier>
    </dependency>
    <dependency>
      <groupId>org.silverpeas.jakarta</groupId>
      <artifactId>cmis</artifactId>
      <classifier>jakarta</classifier>
    </dependency>
    <dependency>
      <groupId>org.silverpeas.core</groupId>
      <artifactId>silverpeas-core-web</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.silverpeas.core</groupId>
      <artifactId>silverpeas-core-war</artifactId>
      <version>${project.version}</version>
      <type>war</type>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <!-- the specification, the rendering page and the Redoc engine join the site once it
               has been generated: the index.html of Redoc must replace the one of the Maven site -->
          <execution>
            <id>gather-openapi-document</id>
            <phase>site</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/site</outputDirectory>
              <!-- the rendering page must replace the index.html generated by the Maven site -->
              <overwrite>true</overwrite>
              <resources>
                <resource>
                  <directory>${project.build.directory}/openapi</directory>
                </resource>
                <resource>
                  <directory>${project.basedir}/src/site/resources</directory>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>unpack-redoc</id>
            <phase>site</phase>
            <goals>
              <goal>unpack</goal>
            </goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>org.webjars.npm</groupId>
                  <artifactId>redoc</artifactId>
                  <version>2.5.0</version>
                  <includes>META-INF/resources/webjars/redoc/2.5.0/bundles/redoc.standalone.js</includes>
                  <overWrite>true</overWrite>
                  <outputDirectory>${project.build.directory}/site</outputDirectory>
                  <fileMappers>
                    <org.codehaus.plexus.components.io.filemappers.FlattenFileMapper/>
                  </fileMappers>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
          <execution>
            <id>unpack-war-classes</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>unpack</goal>
            </goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>org.silverpeas.core</groupId>
                  <artifactId>silverpeas-core-war</artifactId>
                  <version>${project.version}</version>
                  <type>war</type>
                  <includes>WEB-INF/classes/**</includes>
                  <outputDirectory>${project.build.outputDirectory}</outputDirectory>
                  <fileMappers>
                    <org.codehaus.plexus.components.io.filemappers.RegExpFileMapper>
                      <pattern>^WEB-INF/classes/(.*)$</pattern>
                      <replacement>$1</replacement>
                    </org.codehaus.plexus.components.io.filemappers.RegExpFileMapper>
                  </fileMappers>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>io.swagger.core.v3</groupId>
        <artifactId>swagger-maven-plugin-jakarta</artifactId>
        <version>2.2.54</version>
        <configuration>
          <outputFileName>openapi</outputFileName>
          <outputPath>${project.build.directory}/openapi</outputPath>
          <outputFormat>JSONANDYAML</outputFormat>
          <prettyPrint>true</prettyPrint>
          <sortOutput>true</sortOutput>
          <openapi31>true</openapi31>
          <defaultResponseCode>200</defaultResponseCode>
          <!-- completes each operation with the responses common to all the endpoints -->
          <!-- the schema resolver must read the JAXB annotations of the web entities -->
          <modelConverterClasses>org.silverpeas.core.restapi.JaxbAwareModelResolver</modelConverterClasses>
          <filterClass>org.silverpeas.core.restapi.CommonResponsesFilter</filterClass>
          <!-- the SCIM API isn't meant to be published -->
          <ignoredRoutes>
            <route>/domains/{domainId}/scim/.search</route>
            <route>/domains/{domainId}/scim/Bulk</route>
            <route>/domains/{domainId}/scim/Groups</route>
            <route>/domains/{domainId}/scim/Groups/.search</route>
            <route>/domains/{domainId}/scim/Groups/{id}</route>
            <route>/domains/{domainId}/scim/Me</route>
            <route>/domains/{domainId}/scim/Schemas</route>
            <route>/domains/{domainId}/scim/Schemas/{uri}</route>
            <route>/domains/{domainId}/scim/ServiceProviderConfig</route>
            <route>/domains/{domainId}/scim/ServiceProviderConfig/{name}</route>
            <route>/domains/{domainId}/scim/Users</route>
            <route>/domains/{domainId}/scim/Users/.search</route>
            <route>/domains/{domainId}/scim/Users/{id}</route>
          </ignoredRoutes>
          <resourcePackages>
            <package>org.silverpeas.core.webapi</package>
            <package>org.silverpeas.web</package>
          </resourcePackages>
        </configuration>
        <executions>
          <execution>
            <phase>process-classes</phase>
            <goals>
              <goal>resolve</goal>
            </goals>
          </execution>
        </executions>
        <dependencies>
          <dependency>
            <groupId>org.jboss.resteasy</groupId>
            <artifactId>resteasy-core</artifactId>
            <version>6.2.14.Final</version>
          </dependency>
        </dependencies>
      </plugin>
    </plugins>
  </build>

</project>
